@page
@model PaymentSystem.Pages.Payments.CreateModel
@{ ViewData["Title"] = "Create payment"; }
<p class="eyebrow">NEW ORDER</p><h1 class="page-title">Create a payment.</h1><p class="text-secondary mb-4">Generate a KHQR code for an order. Payment is confirmed only after trusted Bakong verification.</p>
@if (Model.IsTestEnvironment) { <div class="environment-notice"><strong>Test environment (SIT).</strong> Do not pay with a real banking app. Real payments require production verification.</div> }
<form method="post" class="form-panel"><div asp-validation-summary="All" class="text-danger" role="alert"></div><input type="hidden" asp-for="Input.ProductId" />
@if (Model.Product != null) { <div class="order-summary mb-4"><span class="eyebrow">YOU'RE ORDERING</span><h2 class="h4">@Model.Product.Name</h2><p class="mb-0">@Model.Product.Price.ToString("N2") @Model.Product.Currency per item</p></div><div class="mb-3"><label asp-for="Input.Quantity" class="form-label"></label><input asp-for="Input.Quantity" class="form-control" type="number" min="1" max="100" /><small>The total uses the current product price on the server.</small></div> }
else { <div class="row"><div class="col-sm-7 mb-3"><label asp-for="Input.Amount" class="form-label"></label><input asp-for="Input.Amount" class="form-control" type="number" min="0.01" step="0.01" /></div><div class="col-sm-5 mb-3"><label asp-for="Input.Currency" class="form-label"></label><select asp-for="Input.Currency" class="form-select"><option>USD</option><option>KHR</option></select></div></div><p class="small text-secondary">Use two decimal places for USD or whole riel for KHR.</p> }
<div class="mb-4"><label asp-for="Input.OrderId" class="form-label">Order ID</label><input asp-for="Input.OrderId" class="form-control" maxlength="50" /><small>Every order ID must be unique.</small></div><button class="btn btn-dark">Generate KHQR</button> <a asp-page="/Products/Index" class="btn btn-outline-secondary">Back to catalog</a></form>
