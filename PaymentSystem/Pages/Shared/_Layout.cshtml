@using Microsoft.AspNetCore.Identity
@using PaymentSystem.Models
@inject UserManager<ApplicationUser> UserManager
@inject IConfiguration Configuration
@{
    var authenticated = User.Identity?.IsAuthenticated == true;
    var account = authenticated ? await UserManager.GetUserAsync(User) : null;
    var displayName = account?.DisplayName ?? "Account";
    var isTest = Configuration["Bakong:BaseUrl"]?.Contains("sit-", StringComparison.OrdinalIgnoreCase) == true;
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    string Active(string page) => currentPage == page ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="KHQR payment and product management workspace." />
    <title>@ViewData["Title"] | KHQR Workspace</title>
    <link href="~/lib/bootstrap/bootstrap.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="@(authenticated ? "workspace-body" : "auth-body")">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <svg class="icon-library" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
        <symbol id="i-grid" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></symbol>
        <symbol id="i-box" viewBox="0 0 24 24"><path d="m12 3 9 5v9l-9 5-9-5V8l9-5Z M3 8l9 5 9-5 M12 13v9 M7.5 5.5l9 5"/></symbol>
        <symbol id="i-card" viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="15" rx="3"/><path d="M2 10h20 M6 15h4"/></symbol>
        <symbol id="i-users" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><path d="M3 21v-3a6 6 0 0 1 12 0v3 M16 5a3 3 0 0 1 0 6 M21 21v-3a6 6 0 0 0-4-5"/></symbol>
        <symbol id="i-settings" viewBox="0 0 24 24"><path d="m12 3 2 3 4-1 1 4 3 3-3 2-1 5-4-1-2 3-2-3-4 1-1-4-3-3 3-2 1-5 4 1 2-3Z"/><circle cx="12" cy="12" r="3"/></symbol>
        <symbol id="i-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 22v-2a8 8 0 0 1 16 0v2"/></symbol>
    </svg>
    @if (authenticated)
    {
        <aside class="sidebar">
            <a class="brand" asp-page="/Index"><span class="brand-mark">K</span><span>KHQR<span class="brand-subtitle">Payment workspace</span></span></a>
            <p class="nav-caption">WORKSPACE</p>
            <nav class="sidebar-nav" aria-label="Workspace navigation">
                <a class="@Active("/Index")" asp-page="/Index" aria-current="@(currentPage == "/Index" ? "page" : null)"><svg><use href="#i-grid"/></svg>Overview</a>
                <a class="@Active("/Products/Index")" asp-page="/Products/Index"><svg><use href="#i-box"/></svg>Products</a>
                <a class="@(currentPage.StartsWith("/Payments/") ? "active" : "")" asp-page="/Payments/Index"><svg><use href="#i-card"/></svg>Payments</a>
            </nav>
            @if (User.IsInRole("Admin"))
            {
                <p class="nav-caption">ADMINISTRATION</p>
                <nav class="sidebar-nav" aria-label="Administration navigation">
                    <a class="@Active("/Admin/Index")" asp-page="/Admin/Index"><svg><use href="#i-settings"/></svg>Admin overview</a>
                    <a class="@(currentPage.StartsWith("/Admin/Products/") ? "active" : "")" asp-page="/Admin/Products/Index"><svg><use href="#i-box"/></svg>Manage products</a>
                    <a class="@Active("/Admin/Users")" asp-page="/Admin/Users"><svg><use href="#i-users"/></svg>User management</a>
                </nav>
            }
            <div class="sidebar-bottom">
                <div class="sidebar-note"><strong>Verified by the bank.</strong><span>Payments are confirmed only after a matching Bakong transaction.</span></div>
                <a asp-page="/Account/Manage" class="profile-link"><span class="avatar">@displayName[..1].ToUpperInvariant()</span><span><strong>@displayName</strong><small>@(User.IsInRole("Admin") ? "Administrator" : "Personal account")</small></span></a>
            </div>
        </aside>
    }
    <div class="@(authenticated ? "workspace-shell" : "auth-shell")">
        <header class="topbar">
            @if (authenticated)
            {
                <div class="breadcrumb-label">Workspace <span>/</span> <strong>@ViewData["Title"]</strong></div>
                <div class="topbar-actions"><span class="environment-label @(isTest ? "environment-test" : "")">@(isTest ? "SIT · Test mode" : "Production verification")</span><a asp-page="/Account/Manage" class="account-link">My account</a><form method="post" asp-page="/Account/Logout"><button class="btn btn-sm btn-outline-secondary">Sign out</button></form></div>
            }
            else
            {
                <a class="brand" asp-page="/Index"><span class="brand-mark">K</span>KHQR Workspace</a>
                <nav class="auth-nav" aria-label="Account navigation"><a asp-page="/Account/Login">Sign in</a><a asp-page="/Account/Register" class="btn btn-sm btn-outline-dark">Create account</a></nav>
            }
        </header>
        <main id="main-content" class="workspace-main" tabindex="-1">@RenderBody()</main>
        <footer class="app-footer"><span>&copy; @DateTime.UtcNow.Year KHQR Workspace</span><span>Payment operations, made clear.</span></footer>
    </div>
    <script src="~/js/workspace.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
