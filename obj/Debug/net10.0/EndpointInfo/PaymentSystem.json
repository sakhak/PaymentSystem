{
  "openapi": "3.1.1",
  "info": {
    "title": "PaymentSystem | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:7286"
    },
    {
      "url": "http://localhost:5291"
    }
  ],
  "paths": {
    "/api/payments": {
      "get": {
        "tags": [
          "Payments"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/payments/check": {
      "post": {
        "tags": [
          "Payments"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckPaymentRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckPaymentRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CheckPaymentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/payments/create": {
      "post": {
        "tags": [
          "Payments"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePaymentRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePaymentRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePaymentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CheckPaymentRequest": {
        "required": [
          "md5"
        ],
        "type": "object",
        "properties": {
          "md5": {
            "pattern": "^[a-fA-F0-9]{32}$",
            "type": "string"
          }
        }
      },
      "CreatePaymentRequest": {
        "required": [
          "orderId",
          "currency"
        ],
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string"
          },
          "amount": {
            "maximum": 1000000,
            "minimum": 0.01,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "currency": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Payments"
    }
  ]
}